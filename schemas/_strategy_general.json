{
  "$schema": "https://raw.githubusercontent.com/mindsocket/structured-context/main/schemas/generated/latest/_structured_context_schema_meta.json",
  "$id": "sctx://core/_strategy_general",
  // Shared entity definitions for strategy-general schemas.
  // Provides a hierarchy, aliases, relationships, and entity type $defs.
  // Schemas that import this partial get its metadata; a $ref to its $defs alone brings none.
  "$metadata": {
    "hierarchy": {
      "levels": [
        "vision",
        "mission",
        { "type": "goal", "selfRef": true, "matchers": ["Goals"] },
        { "type": "opportunity", "selfRef": true, "matchers": ["Opportunities"] },
        {
          "type": "solution",
          "selfRef": true,
          "matchers": ["Solutions", "Potential solutions", "Solutions considered", "Possible solutions"]
        },
        "experiment"
      ]
    },
    "aliases": {
      "outcome": "goal",
      "assumption_test": "experiment",
      "test": "experiment"
    },
    "relationships": [
      {
        "parent": "opportunity",
        "type": "problem_statement",
        "templateFormat": "heading",
        "matchers": ["Problem statement", "What problem are we solving?"],
        "multiple": false
      },
      {
        "parent": "opportunity",
        "type": "assumption",
        "templateFormat": "table",
        "matchers": ["Assumptions", "^Assumptions?$"],
        "embeddedTemplateFields": ["assumption", "status", "confidence"],
        "multiple": true
      }
    ],
    "rules": [
      {
        "id": "goals-distinct",
        "category": "coherence",
        "description": "Sibling goals are distinct: progress on one is not progress on another",
        "when": "$count(nodes[$$.current.id in resolvedParentIds and resolvedType = 'goal']) >= 2",
        "semantic": {
          "rubric": "Judge the item's child goals as a set, and ignore its other children. They are distinct when each is a different result, so that achieving one does not achieve another.",
          "scope": ["children"],
          "verdicts": {
            "distinct": "Each child goal is a different result",
            "overlapping": {
              "description": "Two child goals partly cover the same result, or one contains another",
              "guidance": "Sharpen the boundary between them, or nest the narrower one under the broader one."
            },
            "duplicate": {
              "description": "Two child goals state the same result in different words",
              "guidance": "Merge them."
            }
          },
          "severity": { "overlapping": "warning", "duplicate": "warning" }
        }
      },
      {
        "id": "goals-cover-parent",
        "category": "best-practice",
        "description": "Together, a mission's or goal's child goals cover what it needs",
        "when": "$count(nodes[$$.current.id in resolvedParentIds and resolvedType = 'goal']) >= 2",
        "semantic": {
          "rubric": "Judge the item's child goals as a set, and ignore its other children. Pass when achieving all of them would achieve the item as its title and body state it. Fail when a part that the item names or plainly needs has no goal.",
          "scope": ["children"],
          "includeContent": "fullScope"
        }
      },
      {
        "id": "goal-advances-parent",
        "category": "coherence",
        "type": "goal",
        "description": "A goal advances its parent mission, or is one part of its parent goal",
        "when": "$exists(parent)",
        "semantic": {
          "scope": ["parent"],
          "verdicts": {
            "advances": "Under a mission, achieving it moves the mission forward. Under a goal, it is one part of the parent goal, narrower than the parent",
            "weak-link": {
              "description": "Related to the parent, but the link is indirect, or it only restates the parent",
              "guidance": "Say how it advances the parent, or narrow it to one part of the parent."
            },
            "misplaced": {
              "description": "Achieving it would not advance the parent",
              "guidance": "Move it under the mission or goal it advances."
            }
          },
          "severity": { "weak-link": "info", "misplaced": "warning" }
        }
      },
      {
        "id": "opportunity-serves-ancestors",
        "category": "coherence",
        "type": "opportunity",
        "description": "Pursuing the opportunity serves the mission and vision above it, not only its parent goal",
        "semantic": {
          "rubric": "Follow the chain from the opportunity through its goals to the mission and vision. Pass when pursuing it serves every level. Fail when it would advance its parent but work against, or ignore, the intent of a level above.",
          "scope": ["ancestors"],
          "includeContent": "fullScope"
        }
      },
      {
        "id": "problem-statement-names-no-solution",
        "category": "best-practice",
        "type": "problem_statement",
        "description": "The problem statement states a problem, and does not name or presume a solution",
        "semantic": { "includeContent": "nodeOnly" }
      }
    ]
  },
  "$defs": {
    "dashboard": {
      "type": "object",
      "description": "An overview page for the space. It is not part of the hierarchy.",
      "allOf": [{ "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" }],
      "properties": {
        "type": { "const": "dashboard" }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "ost_on_a_page": {
      "type": "object",
      "description": "A one-page view of the tree or the space. It is not part of the hierarchy.",
      "allOf": [{ "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" }],
      "properties": {
        "type": { "enum": ["ost_on_a_page", "space_on_a_page"] }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "vision": {
      "type": "object",
      "description": "The future you want to exist: a lasting, aspirational state of the world, not a plan or an activity.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "vision" }
      },
      "required": ["type"],
      "not": { "required": ["parent"] },
      "additionalProperties": true,
      "examples": [
        {
          "type": "vision",
          "status": "active"
        }
      ]
    },
    "mission": {
      "type": "object",
      "description": "What you do, and for whom, to move towards the vision. It lasts for years and guides which goals to pursue.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "mission" }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "mission",
          "status": "active",
          "parent": "[[Personal Vision]]"
        }
      ]
    },
    "goal": {
      "type": "object",
      "description": "A result to achieve, which advances the parent mission or goal. A child goal is one part of its parent goal. Together, a parent's goals should cover what it needs.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "enum": ["goal", "outcome"] },
        "priority": { "$ref": "sctx://core/_sctx_base#/$defs/priority" }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "goal",
          "status": "active",
          "parent": "[[My Mission (2026)]]",
          "priority": "p2"
        }
      ]
    },
    "opportunity": {
      "type": "object",
      "description": "A need, problem or opening that, if addressed, advances the parent goal. A child opportunity is one part of its parent opportunity.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "opportunity" },
        "priority": { "$ref": "sctx://core/_sctx_base#/$defs/priority" },
        "impact": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "feasibility": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "resources": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "timeline": {
          "type": "string",
          "description": "Timeline estimate (e.g., S-M, M-L)"
        },
        "next_steps": {
          "type": "string",
          "description": "Next steps for this opportunity"
        }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "opportunity",
          "status": "identified",
          "parent": "[[Career Growth]]",
          "priority": "p2"
        }
      ]
    },
    "solution": {
      "type": "object",
      "description": "One way to address the parent opportunity.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "solution" },
        "priority": { "$ref": "sctx://core/_sctx_base#/$defs/priority" },
        "impact": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "feasibility": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "resources": { "$ref": "sctx://core/_sctx_base#/$defs/assessment" },
        "timeline": {
          "type": "string",
          "description": "Timeline estimate (e.g., S-M, M-L)"
        },
        "next_steps": {
          "type": "string",
          "description": "Next steps for this solution"
        }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "solution",
          "status": "identified",
          "parent": "[[Some Opportunity]]",
          "priority": "p3"
        }
      ]
    },
    "experiment": {
      "type": "object",
      "description": "A small test of an assumption behind the parent, whose result decides what to do next.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "enum": ["experiment", "assumption_test", "test"] }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "experiment",
          "status": "exploring",
          "parent": "[[Build a Side Project]]"
        },
        {
          "type": "test",
          "status": "active",
          "parent": "[[Mobile App Solution]]"
        }
      ]
    },
    "assumption": {
      "type": "object",
      "description": "A belief that must hold for the parent opportunity to succeed, with how confident you are in it.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "assumption" },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Confidence level in this assumption"
        }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "assumption",
          "status": "identified",
          "parent": "[[Some Opportunity]]",
          "confidence": "medium"
        }
      ]
    },
    "problem_statement": {
      "type": "object",
      "description": "The problem that the parent opportunity addresses: who has it, what it is and why it matters. It names no solution.",
      "allOf": [
        { "$ref": "sctx://core/_sctx_base#/$defs/baseNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/parentNodeProps" },
        { "$ref": "sctx://core/_sctx_base#/$defs/ostEntityProps" }
      ],
      "properties": {
        "type": { "const": "problem_statement" }
      },
      "required": ["type"],
      "additionalProperties": true,
      "examples": [
        {
          "type": "problem_statement",
          "status": "identified"
        }
      ]
    }
  }
}
