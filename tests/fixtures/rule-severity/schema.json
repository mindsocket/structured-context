{
  "$schema": "https://raw.githubusercontent.com/mindsocket/structured-context/main/schemas/generated/latest/_structured_context_schema_meta.json",
  "$id": "sctx://rule-severity.schema",
  "$metadata": {
    "hierarchy": {
      "levels": ["goal"]
    },
    "rules": [
      {
        "id": "always-info",
        "category": "best-practice",
        "description": "Best-practice rule that always fails (default severity: info)",
        "type": "goal",
        "check": "false"
      },
      {
        "id": "always-warning",
        "category": "coherence",
        "description": "Coherence rule that always fails (default severity: warning)",
        "type": "goal",
        "check": "false"
      },
      {
        "id": "not-blocked",
        "category": "workflow",
        "severity": "error",
        "description": "Goals must not be blocked (workflow rule overridden to error)",
        "type": "goal",
        "check": "current.status != 'blocked'"
      }
    ]
  },
  "type": "object",
  "properties": {
    "type": { "const": "goal" },
    "title": { "type": "string" },
    "status": { "type": "string" }
  },
  "required": ["type"],
  "additionalProperties": true
}
