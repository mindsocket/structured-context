{
  "$schema": "https://raw.githubusercontent.com/mindsocket/structured-context/main/schemas/generated/latest/_structured_context_schema_meta.json",
  "$id": "sctx://judge-test",
  "$metadata": {
    "hierarchy": { "levels": ["outcome", "opportunity", "solution"] },
    "rules": [
      {
        "id": "opportunity-framing",
        "category": "coherence",
        "mode": "semantic",
        "type": "opportunity",
        "description": "The opportunity is a customer need or pain point, not a solution or a business goal",
        "verdicts": {
          "customer-need": "A need or pain point, in terms of what the customer experiences",
          "solution": {
            "description": "A feature, product or solution the business could build",
            "guidance": "Restate it as the customer problem this solution would solve."
          }
        },
        "severity": { "solution": "error" }
      },
      {
        "id": "solution-addresses-parent",
        "category": "best-practice",
        "mode": "semantic",
        "type": "solution",
        "description": "The solution plausibly addresses its parent opportunity"
      }
    ]
  },
  "oneOf": [
    {
      "type": "object",
      "properties": { "type": { "const": "outcome" }, "title": { "type": "string" } },
      "required": ["type", "title"]
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "opportunity" },
        "title": { "type": "string" },
        "parent": { "type": "string" }
      },
      "required": ["type", "title"]
    },
    {
      "type": "object",
      "properties": { "type": { "const": "solution" }, "title": { "type": "string" }, "parent": { "type": "string" } },
      "required": ["type", "title"]
    }
  ]
}
